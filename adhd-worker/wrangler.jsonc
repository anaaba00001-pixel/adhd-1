{
  "name": "adhd-guide",
  "main": "worker.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adhd-guide-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
